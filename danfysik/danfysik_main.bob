    <name>ControlMode</name>
    <pv_name>$(P):$(R):CTRL_MODE</pv_name>
    <x>120</x>
    <y>85</y>
    <width>80</width>
  </widget>
  <widget type="label" version="2.0.0">
    <name>ConnectionLabel</name>
    <text>Connected:</text>
    <x>480</x>
    <y>85</y>
    <width>70</width>
  </widget>
