  <widget type="action_button" version="3.0.0">
    <name>UnimagButton</name>
    <actions>
      <action type="open_display">
        <description>Open UNIMAG Interface</description>
        <file>danfysik_unimag.bob</file>
        <macros>
          <DEVICE>$(DEVICE)</DEVICE>
        </macros>
        <target>tab</target>
      </action>
    </actions>
    <text>UNIMAG Interface</text>
    <x>20</x>
    <y>656</y>
    <width>150</width>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>ExpertButton</name>
    <actions>
      <action type="open_display">
        <description>Open Expert Interface</description>
        <file>danfysik_expert.bob</file>
        <macros>
          <DEVICE>$(DEVICE)</DEVICE>
        </macros>
        <target>tab</target>
      </action>
    </actions>
    <text>Expert Panel</text>
    <x>180</x>
    <y>656</y>
    <width>120</width>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="stripchart" version="2.1.0">
    <name>CurrentPlot</name>
    <x>20</x>
    <y>706</y>
    <width>1160</width>
    <height>200</height>
    <title>Current vs Time</title>
    <show_toolbar>false</show_toolbar>
    <show_legend>true</show_legend>
    <traces>
      <trace>
        <name>$(traces[0].y_pv)</name>
        <y_pv>$(P):$(R):I_RB</y_pv>
        <axis>0</axis>
        <trace_type>2</trace_type>
        <color>
          <color red="0" green="0" blue="255">
          </color>
        </color>
        <line_width>2</line_width>
        <point_type>0</point_type>
        <point_size>10</point_size>
        <visible>true</visible>
      </trace>
      <trace>
        <name>$(traces[1].y_pv)</name>
        <y_pv>$(P):$(R):I_SP</y_pv>
        <axis>0</axis>
        <trace_type>2</trace_type>
        <color>
          <color red="255" green="0" blue="0">
          </color>
        </color>
        <line_width>2</line_width>
        <point_type>0</point_type>
        <point_size>10</point_size>
        <visible>true</visible>
      </trace>
    </traces>
  </widget>
  <widget type="rectangle" version="2.0.0">
    <name>FaultFrame</name>
