    <text>Main Control</text>
    <x>30</x>
    <y>195</y>
    <width>150</width>
    <font>
      <font name="Header 2" family="Liberation Sans" style="BOLD" size="18.0">
      </font>
    </font>
  </widget>
  <widget type="bool_button" version="2.0.0">
    <name>PowerButton</name>
    <pv_name>$(P):$(R):POWER_SP</pv_name>
    <x>30</x>
    <y>220</y>
    <off_label>Power OFF</off_label>
    <off_color>
      <color name="STOP" red="255" green="0" blue="0">
      </color>
    </off_color>
    <on_label>Power ON</on_label>
    <on_color>
      <color name="OK" red="0" green="255" blue="0">
      </color>
    </on_color>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>ResetButton</name>
    <actions>
      <action type="write_pv">
        <description>Reset Interlocks</description>
        <pv_name>$(P):$(R):RESET</pv_name>
        <value>1</value>
      </action>
    </actions>
    <text>RESET</text>
    <x>140</x>
    <y>220</y>
    <width>80</width>
    <background_color>
      <color name="MINOR" red="255" green="128" blue="0">
      </color>
    </background_color>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>GlobalOffButton</name>
    <actions>
      <action type="write_pv">
        <description>Global Soft Shutdown</description>
        <pv_name>$(P):$(R):GOFF</pv_name>
        <value>1</value>
      </action>
    </actions>
    <text>GLOBAL OFF</text>
    <x>230</x>
    <y>220</y>
    <background_color>
      <color name="MAJOR" red="255" green="0" blue="0">
      </color>
    </background_color>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="bool_button" version="2.0.0">
    <name>RemoteButton</name>
    <pv_name>$(P):$(R):REMOTE</pv_name>
    <x>340</x>
    <y>220</y>
    <off_label>LOCAL</off_label>
    <on_label>REMOTE</on_label>
  </widget>
  <widget type="bool_button" version="2.0.0">
    <name>RemoteLockButton</name>
