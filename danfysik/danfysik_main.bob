    <name>StatusString</name>
    <pv_name>$(P):$(R):STATUS</pv_name>
    <x>700</x>
    <y>110</y>
    <width>470</width>
  </widget>
  <widget type="rectangle" version="2.0.0">
    <name>ControlFrame</name>
    <x>20</x>
    <y>185</y>
    <width>560</width>
    <height>180</height>
    <line_color>
      <color name="Grid" red="128" green="128" blue="128">
