<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>restoredisplay</name>
  <width>760</width>
  <macros>
    <GROUP>mag</GROUP>
  </macros>
  <scripts>
    <script file="scripts/LoadRestoreDataSet.py">
      <pv_name>loc://restorefile-$(DID)&lt;VString&gt;("$(DATASET=)")</pv_name>
    </script>
  </scripts>
  <widget type="label" version="2.0.0">
    <name>MagnetSourceId</name>
    <text>$(MAGNET_SOURCE_ID)</text>
    <visible>false</visible>
  </widget>
  <widget type="label" version="2.0.0"><name>TestReportPath</name><text>$(TEST_REPORT=)</text><visible>false</visible></widget>
  <widget type="label" version="2.0.0"><name>TestDatasetFile</name><text>$(DATASET=)</text><visible>false</visible></widget>
</display>
